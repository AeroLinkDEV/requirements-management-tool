<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AeroLink.DocumentSecurity\AeroLink.DocumentSecurity.csproj" />
    <ProjectReference Include="..\AeroLink.Domain\AeroLink.Domain.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- Not used directly. MailKit/MimeKit and PDFsharp bring in 10.0.0, which is affected by GHSA-846f-f764-76mx
         and GHSA-2fmv-rv2c-59x7 (10.0.0 to 10.0.12). The fixed package also wins publish conflict resolution over
         the shared framework's older copy, so a self-contained release ships it (#1614). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.9" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Frozen v1 function is part of its additive migration contract. A future version adds a new artifact. -->
    <EmbeddedResource Include="Persistence\Migrations\ProblemReportSourceIdentityV1.sql" />
    <!-- Composing a message and sending it are separate concerns, and only the first can be asserted without
         a mail relay. Exposing internals to the test assembly is what lets the composed shape be checked. -->
    <InternalsVisibleTo Include="AeroLink.Infrastructure.Tests" />
  </ItemGroup>

</Project>
