<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A release build passes -p:Version from product/release/VERSION and -p:SourceRevisionId (#1614 1.6).
         Every other build reports this version, so a development binary can never claim to be a release. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Characterization tests pin the authority-resolution seams this assembly owns (#816 Slice 1).
         Test-only visibility; no runtime surface change. -->
    <InternalsVisibleTo Include="AeroLink.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AeroLink.ConnectorProtocol\AeroLink.ConnectorProtocol.csproj" />
    <ProjectReference Include="..\AeroLink.Domain\AeroLink.Domain.csproj" />
    <ProjectReference Include="..\AeroLink.Infrastructure\AeroLink.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>
