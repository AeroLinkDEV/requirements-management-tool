# Operating-system and editor files
.DS_Store
Thumbs.db
~$*.docx
*.tmp

# Local scratch and generated review output
.tmp/
.codex-temp/
artifacts/
out/
rendered/

# Product build and local runtime output
**/bin/
!product/ci-metrics/bin/
!product/ci-metrics/bin/**
**/obj/
**/node_modules/
**/dist/
*.db
*.db-shm
*.db-wal
product/.local/

# Playwright output. Both configs write their own reports and traces; the production config keeps separate
# directories so a production run cannot overwrite the diagnostics of the run that preceded it.
product/client/test-results/
product/client/test-results-production/
product/client/playwright-report/
product/client/playwright-report-production/

# Rendered output of the overview video. docs/overview-video carries its own rule for this, but a nested
# rule only applies while that directory is checked out — from any other branch the leftover build folder,
# 24 MB of frames and an MP4, is reported as untracked. Generated output should be ignored from wherever
# you happen to be standing.
docs/overview-video/build/

# Session handoff notes, written for a human to read across a restart and then deleted. Never part of a
# change, and an untracked file in the root reads as work in progress when it is the opposite.
HANDOFF-*.md
PR-BODY-*.md
