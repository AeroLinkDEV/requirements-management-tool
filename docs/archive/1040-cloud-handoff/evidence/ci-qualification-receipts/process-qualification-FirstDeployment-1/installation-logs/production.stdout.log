      LEFT JOIN project_ladder_steps AS p0 ON p2."Id" = p0."ConfigurationId" AND p2."ProjectId" = p0."ProjectId"
      LEFT JOIN project_ladder_allowed_upstreams AS p1 ON p2."Id" = p1."ConfigurationId" AND p2."ProjectId" = p1."ProjectId"
      ORDER BY p2."Id", p0."Id"
