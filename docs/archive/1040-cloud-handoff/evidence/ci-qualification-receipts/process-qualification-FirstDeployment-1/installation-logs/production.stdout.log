      SELECT p."GrantedAt", u."UserName", u."Id", u."State"
      FROM program_memberships AS p
      INNER JOIN user_accounts AS u ON p."UserId" = u."Id"
      WHERE p."ProgramId" = @programId AND p."EndedAt" IS NULL AND p."Role" = @value AND u."State" = 'Active'
