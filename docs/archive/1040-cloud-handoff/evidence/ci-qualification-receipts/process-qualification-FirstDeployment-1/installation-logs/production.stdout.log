info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[@projectId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT EXISTS (
          SELECT 1
          FROM projects AS p
          WHERE p."Id" = @projectId)
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@projectId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT p2."Id", p2."ActivatedAt", p2."ActivatedBy", p2."ActivationManifestHash", p2."ActivationManifestVersion", p2."Classification", p2."CreatedAt", p2."IsSealed", p2."LastUpgradeAt", p2."LastUpgradeBy", p2."LastUpgradeManifestHash", p2."LastUpgradeVersion", p2."ProjectId", p2."RetiredAt", p2."RetiredBy", p2."SealedAt", p2."SealedBy", p2."SealedContentIdentity", p2."SealedContentKind", p2."State", p2."UpdatedAt", p2."VerificationProfileSchemaVersion", p2."Version", p0."Id", p0."Capabilities", p0."CatalogueEntry", p0."ConfigurationId", p0."CreatedAt", p0."EnabledArtifactKindsValue", p0."Position", p0."ProjectId", p0."UpdatedAt", p0."Version", p1."Id", p1."ChildStepId", p1."ConfigurationId", p1."CreatedAt", p1."ParentStepId", p1."ProjectId", p1."UpdatedAt", p1."Version"
      FROM (
          SELECT p."Id", p."ActivatedAt", p."ActivatedBy", p."ActivationManifestHash", p."ActivationManifestVersion", p."Classification", p."CreatedAt", p."IsSealed", p."LastUpgradeAt", p."LastUpgradeBy", p."LastUpgradeManifestHash", p."LastUpgradeVersion", p."ProjectId", p."RetiredAt", p."RetiredBy", p."SealedAt", p."SealedBy", p."SealedContentIdentity", p."SealedContentKind", p."State", p."UpdatedAt", p."VerificationProfileSchemaVersion", p."Version"
          FROM project_ladder_configurations AS p
          WHERE p."ProjectId" = @projectId
          LIMIT 2
      ) AS p2
      LEFT JOIN project_ladder_steps AS p0 ON p2."Id" = p0."ConfigurationId" AND p2."ProjectId" = p0."ProjectId"
      LEFT JOIN project_ladder_allowed_upstreams AS p1 ON p2."Id" = p1."ConfigurationId" AND p2."ProjectId" = p1."ProjectId"
      ORDER BY p2."Id", p0."Id"
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[@projectId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT count(*)::int
      FROM requirements AS r
      WHERE r."ProjectId" = @projectId
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[@projectId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT p."Id", p."ArtifactCount", p."ProjectId", p."SynchronizedAt"
      FROM project_workspace_synchronizations AS p
      WHERE p."ProjectId" = @projectId
      LIMIT 2
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[@projectId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT a."Id", a."AppliesTo", a."CreatedAt", a."CreatedBy", a."Description", a."IsActive", a."Key", a."Name", a."ProjectId", a."Version", a0."Id", a0."CreatedAt", a0."CreatedBy", a0."IsRequired", a0."Key", a0."Label", a0."OptionsJson", a0."SchemaId", a0."SortOrder", a0."Type"
      FROM artifact_schema_definitions AS a
      LEFT JOIN artifact_field_definitions AS a0 ON a."Id" = a0."SchemaId"
      WHERE a."ProjectId" = @projectId
      ORDER BY a."Id"
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[@projectId='?' (DbType = Guid), @catalogueSpecificationNumbers='?' (DbType = Object)], CommandType='Text', CommandTimeout='30']
      SELECT r."Level"
      FROM requirement_specifications AS r
      WHERE r."ProjectId" = @projectId AND r."IsActive" AND r."DocumentNumber" = ANY (@catalogueSpecificationNumbers)
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@projectId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT r."Id", r."CreatedAt", r."CreatedBy", r."Description", r."DocumentNumber", r."IsActive", r."Level", r."ProjectId", r."Title", r."UpdatedAt", r."Version"
      FROM requirement_specifications AS r
      WHERE r."ProjectId" = @projectId
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@Select='?' (DbType = Object)], CommandType='Text', CommandTimeout='30']
      SELECT s."Id", s."CreatedAt", s."CreatedBy", s."Heading", s."ParentId", s."Position", s."RequirementArtifactId", s."SpecificationId", s."Type"
      FROM specification_nodes AS s
      WHERE s."SpecificationId" = ANY (@Select) AND s."Type" = 'Section'
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@projectId='?' (DbType = Guid), @allowedLevels='?' (DbType = Object)], CommandType='Text', CommandTimeout='30']
      SELECT r."Id", r."BaseNumber", r."CreatedAt", r."Level", r."ProjectId"
      FROM requirements AS r
      WHERE r."ProjectId" = @projectId AND r."Level" = ANY (@allowedLevels)
      ORDER BY r."BaseNumber"
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[@artifactIds='?' (DbType = Object)], CommandType='Text', CommandTimeout='30']
      SELECT r."Id", r."ArtifactId", r."CreatedAt", r."DerivedRationale", r."EffectiveBaselineId", r."OriginKind", r."ParentKind", r."ParentRevisionIdsJson", r."Rationale", r."Revision", r."SourceBaselineId", r."SourceBaselineImportId", r."SourceChangeRequestId", r."State", r."Statement", r."VerificationMethod"
      FROM requirement_revisions AS r
