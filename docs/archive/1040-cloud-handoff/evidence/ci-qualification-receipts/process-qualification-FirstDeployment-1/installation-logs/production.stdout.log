      Executed DbCommand (1ms) [Parameters=[@projectId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT p1."Id", p1."CreatedAt", p1."ProjectId", p1."UpdatedAt", p1."Version", p0."Id", p0."CreatedAt", p0."DisplayValue", p0."NormalizedValue", p0."Position", p0."ProjectId", p0."UpdatedAt", p0."Version", p0."VocabularyId"
      FROM (
