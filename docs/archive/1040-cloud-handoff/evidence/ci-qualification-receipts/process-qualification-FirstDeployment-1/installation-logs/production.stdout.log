          SELECT p."Id", p."ActivatedAt", p."ActivatedBy", p."ActivationManifestHash", p."ActivationManifestVersion", p."Classification", p."CreatedAt", p."IsSealed", p."LastUpgradeAt", p."LastUpgradeBy", p."LastUpgradeManifestHash", p."LastUpgradeVersion", p."ProjectId", p."RetiredAt", p."RetiredBy", p."SealedAt", p."SealedBy", p."SealedContentIdentity", p."SealedContentKind", p."State", p."UpdatedAt", p."VerificationProfileSchemaVersion", p."Version"
          FROM project_ladder_configurations AS p
          WHERE p."ProjectId" = @projectId
          LIMIT 2
